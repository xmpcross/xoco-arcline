---
/**
 * Small stroked UI icons on a 24x24 grid. Editorial chrome only — social and
 * brand marks still come from LocalIcon.
 */
export type IconName =
  | "arrow-right"
  | "arrow-left"
  | "chevron-down"
  | "search"
  | "sun"
  | "moon"
  | "close"
  | "share"
  | "envelope";

interface Props {
  name: IconName;
  class?: string;
  size?: number;
}

const { name, class: className = "", size = 18 } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "arrow-right" && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === "arrow-left" && <path d="M20 12H5m6-6-6 6 6 6" />}
  {name === "chevron-down" && <path d="m6 9 6 6 6-6" />}
  {
    name === "search" && (
      <>
        <circle cx="11" cy="11" r="6.5" />
        <path d="m16.5 16.5 4 4" />
      </>
    )
  }
  {
    name === "sun" && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4" />
      </>
    )
  }
  {name === "moon" && <path d="M20 14.2A7.4 7.4 0 0 1 9.8 4a8.6 8.6 0 1 0 10.2 10.2Z" />}
  {name === "close" && <path d="m6 6 12 12M18 6 6 18" />}
  {
    name === "share" && (
      <>
        <circle cx="18" cy="5" r="2.5" />
        <circle cx="6" cy="12" r="2.5" />
        <circle cx="18" cy="19" r="2.5" />
        <path d="m8.3 10.8 7.4-4.3m-7.4 6.7 7.4 4.3" />
      </>
    )
  }
  {
    name === "envelope" && (
      <>
        <rect x="3" y="5.5" width="18" height="13" rx="2" />
        <path d="m3.9 7.1 8.1 5.9 8.1-5.9" />
      </>
    )
  }
</svg>
