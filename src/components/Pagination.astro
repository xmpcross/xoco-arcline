---
import Icon from "@/components/ui/Icon.astro";

interface Props {
  prevUrl?: string;
  nextUrl?: string;
  currentPage: number;
  lastPage: number;
  label: string;
}

const { prevUrl, nextUrl, currentPage, lastPage, label } = Astro.props;
---

{
  lastPage > 1 && (
    <nav class="pagination" aria-label={label}>
      {prevUrl ? (
        <a class="btn btn--light btn--sm" href={prevUrl} rel="prev">
          <Icon name="arrow-left" size={16} />
          Previous
        </a>
      ) : (
        <span class="btn btn--light btn--sm" aria-disabled="true">
          <Icon name="arrow-left" size={16} />
          Previous
        </span>
      )}

      <span class="txt-s txt-dim">Page {currentPage} of {lastPage}</span>

      {nextUrl ? (
        <a class="btn btn--light btn--sm" href={nextUrl} rel="next">
          Next
          <Icon name="arrow-right" size={16} />
        </a>
      ) : (
        <span class="btn btn--light btn--sm" aria-disabled="true">
          Next
          <Icon name="arrow-right" size={16} />
        </span>
      )}
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
    margin-top: 3rem;
  }

  .pagination [aria-disabled="true"] {
    pointer-events: none;
  }
</style>
