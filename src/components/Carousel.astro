---
import SectionHead from "@/components/SectionHead.astro";
import Icon from "@/components/ui/Icon.astro";

/**
 * Scroll-snap carousel with a title row, paging arrows, and a progress bar that
 * reports the track's scroll position — not the autoplay timer, so a swipe moves
 * it exactly as far as an arrow does. The track runs the full width of the page and
 * indents its first slide to the container gutter, so the slide the viewport
 * cuts off advertises the overflow. No carousel library is involved and it stays
 * swipeable with JavaScript off.
 */
interface Props {
  title: string;
  /** Accessible name for the scrollable region. */
  label: string;
  id: string;
  /** Milliseconds a slide holds before the carousel advances. */
  duration?: number;
  class?: string;
}

const { title, label, id, duration = 6000, class: className = "" } = Astro.props;
---

<div
  class:list={["carousel", className]}
  style={`--carousel-duration:${duration}ms`}
  data-carousel
>
  <div class="container">
    <SectionHead title={title} id={id}>
      <div class="carousel__nav hover-fade-group">
        <button type="button" class="icon-btn icon-btn--plain" data-carousel-prev aria-label={`Scroll ${label} backwards`}>
          <Icon name="arrow-left" size={20} />
        </button>
        <button type="button" class="icon-btn icon-btn--plain" data-carousel-next aria-label={`Scroll ${label} forwards`}>
          <Icon name="arrow-right" size={20} />
        </button>
      </div>
    </SectionHead>
  </div>

  <div class="carousel__track" role="group" aria-label={label} tabindex="0" data-carousel-track>
    <slot />
  </div>

  <div class="container">
    <div class="carousel__progress" hidden data-carousel-progress>
      <span class="carousel__progress-bar" data-carousel-bar></span>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-carousel-track]");
    const prev = carousel.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const progress = carousel.querySelector<HTMLElement>("[data-carousel-progress]");
    const bar = carousel.querySelector<HTMLElement>("[data-carousel-bar]");
    if (!track || !prev || !next) return;

    /** One slide plus the gap, so a click always lands on a snap point. */
    const step = () => {
      const first = track.firstElementChild as HTMLElement | null;
      if (!first) return track.clientWidth;
      const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 0;
      return first.offsetWidth + gap;
    };

    const maxScroll = () => track.scrollWidth - track.clientWidth;
    const isScrollable = () => maxScroll() > 4;
    const atStart = () => track.scrollLeft <= 4;
    const atEnd = () => track.scrollLeft >= maxScroll() - 4;

    const scrollTo = (left: number) => track.scrollTo({ left, behavior: "smooth" });

    // Both directions wrap: with the carousel advancing on its own, an arrow
    // that dead-ends at the last slide contradicts what the track just did.
    const goPrev = () => (atStart() ? scrollTo(maxScroll()) : scrollTo(track.scrollLeft - step()));
    const goNext = () => (atEnd() ? scrollTo(0) : scrollTo(track.scrollLeft + step()));

    /* Progress ---------------------------------------------------------------
     * The bar reports how far through the rail the reader is, so it fills as
     * slides go past and is full on the last one. It follows the real
     * `scrollLeft`, which means a swipe moves it exactly as much as an arrow
     * does, and it stays useful with autoplay switched off.
     */
    const paint = () => {
      prev.disabled = !isScrollable();
      next.disabled = !isScrollable();

      if (!bar || !progress) return;

      if (!isScrollable()) {
        progress.hidden = true;
        return;
      }

      progress.hidden = false;
      const travelled = Math.min(1, Math.max(0, track.scrollLeft / maxScroll()));
      bar.style.transform = `scaleX(${travelled})`;
    };

    // Scroll events are throttled to the frame, so the bar tracks a smooth
    // scroll continuously without a transition of its own adding lag.
    track.addEventListener("scroll", paint, { passive: true });
    paint();

    /* Autoplay --------------------------------------------------------------- */
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let timer = 0;
    let paused = false;

    const duration = () =>
      Number.parseFloat(getComputedStyle(carousel).getPropertyValue("--carousel-duration")) || 6000;

    const stop = () => {
      window.clearTimeout(timer);
      timer = 0;
    };

    /** Hands the current slide a full turn before the rail moves again. */
    const schedule = () => {
      stop();
      if (paused || reduceMotion.matches || !isScrollable()) return;
      timer = window.setTimeout(() => {
        goNext();
        schedule();
      }, duration());
    };

    const pause = () => {
      paused = true;
      stop();
    };

    const resume = () => {
      paused = false;
      schedule();
    };

    carousel.addEventListener("mouseenter", pause);
    carousel.addEventListener("mouseleave", resume);
    carousel.addEventListener("focusin", pause);
    carousel.addEventListener("focusout", (event) => {
      if (!carousel.contains(event.relatedTarget as Node)) resume();
    });

    // A backgrounded tab would otherwise page through the whole rail unseen.
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) pause();
      else resume();
    });

    prev.addEventListener("click", () => {
      goPrev();
      schedule();
    });

    next.addEventListener("click", () => {
      goNext();
      schedule();
    });

    // A deliberate swipe should not be cut short by the timer firing mid-gesture.
    track.addEventListener("pointerdown", schedule);

    reduceMotion.addEventListener("change", schedule);
    window.addEventListener("resize", () => {
      paint();
      schedule();
    });

    schedule();
  });
</script>
