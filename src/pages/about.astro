---
import { getCollection } from "astro:content";
import PageHeader from "@/components/PageHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SubscribeBand from "@/components/SubscribeBand.astro";
import Avatar from "@/components/ui/Avatar.astro";
import Icon from "@/components/ui/Icon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { getAllAuthors, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
/** Undefined when the configured byline has no published posts. */
const editor = getAllAuthors(allPosts).find((author) => author.name === siteConfig.editor.name);
---

<BaseLayout
  title="Our story"
  description={`Learn about ${siteConfig.name}, who writes it, and the kind of writing readers can expect.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content">
    <div class="container">
      <PageHeader title={siteConfig.name} description={siteConfig.bio} />
    </div>

    <section class="container section-bottom">
      <div class="about-grid">
        <div class="about-body">
          <div class="about-block">
            <h2 class="txt-h2">What we publish</h2>
            <p class="txt-lead txt-dim">
              {siteConfig.name} covers luxury travel at the level where the trip is actually
              shaped: which suite earns its view, when a private transfer is worth it, what a
              spa menu really promises, and which reservations deserve to anchor the itinerary.
            </p>
          </div>
          <div class="about-block">
            <h2 class="txt-h2">How we write it</h2>
            <p class="txt-lead txt-dim">
              Pieces should be specific, honest about value, and useful to someone choosing
              between room categories, arrival plans, tasting menus, and the quiet upgrades that
              make a trip feel effortless. We would rather explain one service detail properly
              than list ten dream hotels.
            </p>
          </div>
        </div>

        {
          editor && (
            <aside class="about-editor" aria-labelledby="about-editor-heading">
              <h2 id="about-editor-heading" class="txt-h3">
                {siteConfig.editor.title}
              </h2>
              <div class="about-editor__person">
                <Avatar name={editor.name} size="xl" />
                <div class="about-editor__identity">
                  <p class="txt-h4">{editor.name}</p>
                  <p class="txt-s txt-dim">{editor.role}</p>
                </div>
              </div>
              <p class="txt-s txt-dim">
                {siteConfig.editor.bio ||
                  `${editor.name} assigns and edits most of what runs here, and answers for the calls the desk gets wrong.`}
              </p>
              <a class="section-more" href={`/author/${editor.slug}/`}>
                Read their stories
                <Icon name="arrow-right" size={14} />
              </a>
            </aside>
          )
        }
      </div>
    </section>

    <SubscribeBand id="about-subscribe" />
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 64rem) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: 4rem;
    }
  }

  .about-body {
    display: grid;
    gap: 2.5rem;
    max-width: 40rem;
  }

  .about-block {
    display: grid;
    gap: 0.75rem;
  }

  .about-editor {
    display: grid;
    justify-items: start;
    align-content: start;
    gap: 1rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    padding: 1.75rem;
  }

  .about-editor__person {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .about-editor__identity {
    display: grid;
    gap: 0.15rem;
  }
</style>
